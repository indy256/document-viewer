<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key><string>org.documentviewer.app</string>
    <key>CFBundleName</key><string>Document Viewer</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleIconFile</key><string>DocumentViewer.icns</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key><string>PDF document</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>com.adobe.pdf</string></array>
            <key>CFBundleTypeExtensions</key><array><string>pdf</string></array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key><string>EPUB book</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>org.idpf.epub-container</string></array>
            <key>CFBundleTypeExtensions</key><array><string>epub</string></array>
        </dict>
    </array>
    <key>UTImportedTypeDeclarations</key>
    <array><dict>
        <key>UTTypeIdentifier</key><string>org.idpf.epub-container</string>
        <key>UTTypeDescription</key><string>EPUB book</string>
        <key>UTTypeConformsTo</key><array><string>public.data</string></array>
        <key>UTTypeTagSpecification</key><dict>
            <key>public.filename-extension</key><array><string>epub</string></array>
            <key>public.mime-type</key><string>application/epub+zip</string>
        </dict>
    </dict></array>
</dict>
</plist>
