include(FetchContent)

string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" pdfium_cpu)
if(CMAKE_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "ARM64" OR pdfium_cpu MATCHES "^(arm64|aarch64)$")
    set(pdfium_arch arm64)
elseif(pdfium_cpu MATCHES "^(amd64|x86_64|x64)$")
    set(pdfium_arch x64)
else()
    message(FATAL_ERROR "Unsupported PDFium architecture: ${CMAKE_SYSTEM_PROCESSOR}")
endif()
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    if(CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
        set(pdfium_arch arm64)
    elseif(CMAKE_OSX_ARCHITECTURES STREQUAL "x86_64")
        set(pdfium_arch x64)
    else()
        message(FATAL_ERROR "Build one macOS architecture at a time.")
    endif()
endif()

if(WIN32)
    set(pdfium_platform win)
    set(pdfium_library bin/pdfium.dll)
    set(pdfium_hash_x64 78a17d9a5f14467631c26a3ac8741b27a0471ecc05bd6a119b523598160a0537)
    set(pdfium_hash_arm64 6c9ac0ddc69edd8a18d47b95098a5b843eaed5c5bbdcb9587a18c196457449f8)
elseif(APPLE)
    set(pdfium_platform mac)
    set(pdfium_library lib/libpdfium.dylib)
    set(pdfium_hash_x64 a93d44238e05de20028446561b951d50988b849efbbe56fe40c0d376c05b45e8)
    set(pdfium_hash_arm64 61424884d4a7f153b808deba6437848e4400834ce30aaf95d3050da44df8f420)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND pdfium_arch STREQUAL "x64")
    set(pdfium_platform linux)
    set(pdfium_library lib/libpdfium.so)
    set(pdfium_hash_x64 eb142f416aed3a72fc5a02dbd5884868a16cb99dc0cf53e6bdd64afbf67b05f4)
else()
    message(FATAL_ERROR "Unsupported PDFium platform: ${CMAKE_SYSTEM_NAME}/${pdfium_arch}")
endif()
FetchContent_Declare(pdfium
    URL "https://github.com/bblanchon/pdfium-binaries/releases/download/chromium/8044/pdfium-${pdfium_platform}-${pdfium_arch}.tgz"
    URL_HASH "SHA256=${pdfium_hash_${pdfium_arch}}")
FetchContent_MakeAvailable(pdfium)
add_library(pdfium_runtime SHARED IMPORTED)
set_target_properties(pdfium_runtime PROPERTIES
    IMPORTED_LOCATION "${pdfium_SOURCE_DIR}/${pdfium_library}"
    INTERFACE_INCLUDE_DIRECTORIES "${pdfium_SOURCE_DIR}/include")
if(WIN32)
    set_target_properties(pdfium_runtime PROPERTIES IMPORTED_IMPLIB "${pdfium_SOURCE_DIR}/lib/pdfium.dll.lib")
endif()

function(copy_pdfium_runtime target)
    if(WIN32)
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "$<TARGET_FILE:pdfium_runtime>" "$<TARGET_FILE_DIR:${target}>")
    endif()
endfunction()
